# Copy this file to ".env" and fill in the values. Do NOT commit the real .env.
PORT=5000
AI_SERVICE_URL=http://localhost:8000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=            # your Supabase SERVICE ROLE key (secret)
QUEUEIQ_ORG_ID=          # the organization (clinic) id this backend serves

# Staff auth — secret used to sign/verify the JWT that protects /api/business/*.
# Set a long random string in production; if unset the server uses an INSECURE
# dev fallback and warns on startup.
JWT_SECRET=

# Absolute path to python.exe for auto-starting the AI service (optional)
AI_PYTHON=
